DEFAULT_TILE_SIZE=512
DEFAULT_TILE_OVERLAP=64
CONFIDENCE_THRESHOLD=0.50
DEMO_MODE=true

# Docker Compose only
POSTGRES_PASSWORD=change-this-local-password
